# Copia este archivo a ".env" y completa los valores (o corre
# scripts/03-setup-db.sh, que puede generar .env automáticamente).
#
# Estas 4 variables las lee de forma NATIVA el entrypoint oficial de la
# imagen odoo:17.0 para conectarse al PostgreSQL del host — NO se ponen
# credenciales en config/odoo/odoo.conf.

# Host de Postgres visto DESDE DENTRO del contenedor. "host.docker.internal"
# se resuelve vía extra_hosts en docker-compose.yml a la IP del gateway del
# bridge de Docker (host-gateway), que apunta al Postgres del HOST.
HOST=host.docker.internal
PORT=5432
USER=odoo
PASSWORD=changeme

# Referencia informativa: el nombre real de la base se fija en
# config/odoo/odoo.conf (db_name) durante el endurecimiento post-instalación,
# no se lee de aquí. Ver README.
DB_NAME=turingtech_crm
